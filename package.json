{
  "name": "wa-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:generate": "pnpm --filter @wa/db generate",
    "db:migrate": "pnpm --filter @wa/db migrate",
    "db:studio": "pnpm --filter @wa/db studio",
    "dev:webhook": "pnpm --filter @wa/webhook dev",
    "dev:worker": "pnpm --filter @wa/worker dev",
    "dev:web": "pnpm --filter @wa/web dev",
    "dev:docs": "pnpm --filter @wa/docs dev",
    "channel:add": "pnpm --filter @wa/worker channel:add",
    "channel:list": "pnpm --filter @wa/worker channel:list",
    "send:test": "pnpm --filter @wa/worker send:test",
    "typecheck": "tsc -b --pretty",
    "test": "pnpm --filter @wa/core --filter @wa/webhook test",
    "webhook:fake": "node tools/fake-webhook.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3"
  }
}
