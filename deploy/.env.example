# Salin ke deploy/.env lalu isi. File itu tidak pernah di-commit.
# Alamat antar-layanan (REDIS_URL, AI_KNOWLEDGE_URL, dst.) sudah disusun di
# compose.yml - tidak perlu diisi di sini.

# ---------- Domain ----------
# Subdomain yang diarahkan ke server ini, tanpa https:// dan tanpa garis miring.
# Dipakai untuk AUTH_URL dan callback webhook Meta (https://DOMAIN/webhooks/...).
DOMAIN="wa.contoh.go.id"

# ---------- Database ----------
# Postgres yang sudah ada (DB bersama). Isinya sama dengan DATABASE_URL di
# .env root dan di apps/ai-knowledge/.env laptop pengembang.
#
# Dipakai web, webhook, worker, dan migrasi (Prisma). Boleh membawa
# parameter Prisma seperti connection_limit.
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=disable&connection_limit=5"
# Database yang SAMA untuk ai-knowledge (Go), tanpa parameter Prisma.
AI_DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=disable"

# Hanya kalau server tidak punya Postgres sendiri: nyalakan Postgres di
# container, lalu arahkan kedua URL di atas ke
#   postgresql://wa:<POSTGRES_PASSWORD>@postgres:5432/wa_platform
# COMPOSE_PROFILES=db-lokal
# POSTGRES_PASSWORD=""        # openssl rand -hex 24

# ---------- Keamanan ----------
# HARUS SAMA dengan ENCRYPTION_KEY di .env yang selama ini memakai database
# di atas. Kunci lain membuat token setiap nomor WA tidak bisa dibaca.
ENCRYPTION_KEY=""

# Sesi login dashboard.   openssl rand -base64 32
AUTH_SECRET=""

# ---------- Meta / WhatsApp Cloud API ----------
# Opsional: keduanya kini disimpan per koneksi di halaman Pengaturan.
# Isi hanya sebagai cadangan untuk install yang belum memindahkannya.
META_APP_SECRET=""
WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_VERSION="v21.0"

LOG_LEVEL="info"

# ---------- Basis pengetahuan & router AI (apps/ai-knowledge) ----------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-embedding-001"

# Kunci bersama dashboard <-> ai-knowledge (header X-Internal-API-Key).
# Samakan dengan INTERNAL_API_KEY di apps/ai-knowledge/.env yang lama, supaya
# header yang tersimpan di endpoint AI tetap cocok.
AI_KNOWLEDGE_API_KEY=""

# Pengunci POST /documents/reset (menghapus SELURUH dokumen). Kosong = reset
# ditolak di produksi.
AI_ADMIN_SECRET_KEY=""

# Penyetelan router /route - kosongkan untuk memakai bawaan.
# Penjelasan tiap angka ada di apps/ai-knowledge/.env.example.
# ROUTE_MIN_SCORE=0.62
# ROUTE_MIN_MARGIN=0.02
# ROUTE_EXAMPLE_MIN=0.9
# ROUTE_EXAMPLE_HINT=0.8
# ROUTE_CHOOSER_MODEL="gemini-flash-lite-latest"
# ROUTE_CHOOSER_TIMEOUT=2.5
