# Salin ke deploy/.env lalu isi. File itu tidak pernah di-commit.
# Alamat antar-layanan (DATABASE_URL, REDIS_URL, AI_KNOWLEDGE_URL, dst.)
# sudah disusun di compose.yml - tidak perlu diisi di sini.

# ---------- Domain ----------
# Subdomain yang diarahkan ke server ini, tanpa https:// dan tanpa garis miring.
# Dipakai untuk AUTH_URL dan callback webhook Meta (https://DOMAIN/webhooks/...).
DOMAIN="wa.contoh.go.id"

# ---------- Database ----------
# Hanya huruf dan angka, karena ikut disusun ke dalam URL koneksi.
#   openssl rand -hex 24
POSTGRES_PASSWORD=""

# ---------- Keamanan ----------
# SALIN DARI .env LAMA kalau memindahkan data: kunci lain membuat token
# setiap nomor WA yang tersimpan tidak bisa dibaca. Install baru:
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Sesi login dashboard.   openssl rand -base64 32
AUTH_SECRET=""

# ---------- Meta / WhatsApp Cloud API ----------
# Opsional: keduanya kini disimpan per koneksi di halaman Pengaturan.
# Isi hanya sebagai cadangan untuk install yang belum memindahkannya.
META_APP_SECRET=""
WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_VERSION="v21.0"

LOG_LEVEL="info"

# ---------- Basis pengetahuan & router AI (apps/ai-knowledge) ----------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-embedding-001"

# Kunci bersama dashboard <-> ai-knowledge (header X-Internal-API-Key).
#   openssl rand -hex 32
AI_KNOWLEDGE_API_KEY=""

# Pengunci POST /documents/reset (menghapus SELURUH dokumen). Kosong = reset
# ditolak di produksi.
AI_ADMIN_SECRET_KEY=""

# Penyetelan router /route - kosongkan untuk memakai bawaan.
# Penjelasan tiap angka ada di apps/ai-knowledge/.env.example.
# ROUTE_MIN_SCORE=0.62
# ROUTE_MIN_MARGIN=0.02
# ROUTE_EXAMPLE_MIN=0.9
# ROUTE_EXAMPLE_HINT=0.8
# ROUTE_CHOOSER_MODEL="gemini-flash-lite-latest"
# ROUTE_CHOOSER_TIMEOUT=2.5
