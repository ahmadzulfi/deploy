# Salin ke apps/ai-knowledge/.env - layanan ini membaca .env di foldernya sendiri,
# bukan .env root. DATABASE_URL root membawa parameter khusus Prisma
# (connection_limit) yang tidak dikenal Postgres bila dikirim driver Go.

PORT=8080

# Boleh database yang sama dengan platform; tabelnya ("docs-gemini-001" dan
# query_cache) dibuat sendiri saat start. Butuh ekstensi pgvector agar cepat.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=disable"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-embedding-001"

# Wajib diisi kalau alamatnya bisa dijangkau dari luar. Dashboard mengirimnya
# sebagai X-Internal-API-Key - samakan dengan AI_KNOWLEDGE_API_KEY di .env root.
INTERNAL_API_KEY=""

# Pengunci POST /documents/reset (menghapus SELURUH dokumen). Kosong = reset
# terbuka bagi siapa pun yang punya INTERNAL_API_KEY, kecuali di production.
ADMIN_SECRET_KEY=""

# ---------- POST /route (node Arahkan AI di claudewa) ----------
# Semua opsional; nilai di bawah adalah bawaannya.
# Di bawah skor ini router menjawab null tanpa bertanya ke model teks.
# Disetel dari 23 soal uji menu Cimahi (salah terendah 0,61, benar terendah 0,64).
ROUTE_MIN_SCORE=0.62
# Hanya dipakai kalau pemilih AI mati atau gagal: dua kandidat teratas yang
# selisihnya kurang dari ini dan beda menu utama dijawab null.
ROUTE_MIN_MARGIN=0.02
# Model teks yang memilih di antara 6 kandidat terdekat. "off" = embedding saja.
ROUTE_CHOOSER_MODEL="gemini-flash-lite-latest"
# Lewat dari ini, router memakai pilihan embedding saja (detik).
ROUTE_CHOOSER_TIMEOUT=2.5
