# ---------- Infra ----------
DATABASE_URL="postgresql://wa:wa_dev_password@localhost:5435/wa_platform?schema=public"
REDIS_URL="redis://localhost:6381"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="wa-media"
S3_ACCESS_KEY="wa_minio"
S3_SECRET_KEY="wa_minio_dev_password"

# ---------- Security ----------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means every stored channel token becomes unreadable. Back it up.
ENCRYPTION_KEY=""

# ---------- Meta / WhatsApp Cloud API ----------
# One Meta App fronts every WABA, so these three are app-level, not per-channel.
# Per-channel values (WABA id, phone number id, system user token) live in the DB.

META_APP_SECRET=""
META_GRAPH_VERSION="v21.0"

# Any string you choose. Paste the same value into the Meta webhook config UI.
WEBHOOK_VERIFY_TOKEN=""

# ---------- Services ----------
# Asal publik receiver webhook, dipakai halaman pengaturan untuk menyusun
# callback URL tiap koneksi. Contoh: https://wa.perusahaan.com
PUBLIC_WEBHOOK_ORIGIN=""
WEBHOOK_PORT=3001
LOG_LEVEL="info"

# ---------- Dashboard ----------
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3002"

# ---------- Basis pengetahuan (apps/ai-knowledge) ----------
# Layanan SOP + pencarian semantik yang dikelola halaman Basis Pengetahuan.
# Kosong = halaman itu hanya menampilkan petunjuk. Untuk uji lokal tanpa
# Gemini: pnpm knowledge:fake, lalu isi "http://localhost:4020".
AI_KNOWLEDGE_URL=""
# Sama dengan INTERNAL_API_KEY di layanan itu; dikirim sebagai X-Internal-API-Key.
AI_KNOWLEDGE_API_KEY=""

# Layanan internal yang boleh dipanggil node Tanya AI, Arahkan AI, dan
# Panggil API walau http atau beralamat jaringan internal - termasuk saat
# NODE_ENV=production, yang selain itu hanya mengizinkan https publik.
# Pasangan host:port dipisah koma; host tanpa port hanya berarti port 80/443.
# Contoh: "localhost:8080" (router Go di server yang sama) atau
# "ai-knowledge:8080" (nama layanan di docker compose). Kosong = tidak ada.
INTERNAL_SERVICE_HOSTS=""
